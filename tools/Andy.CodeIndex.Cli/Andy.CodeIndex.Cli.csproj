<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Andy.CodeIndex.Cli</PackageId>
    <Version>1.0.0</Version>
    <Description>Command-line tool for managing Andy CodeIndex (repositories, search, enrichments).</Description>
    <PackageTags>code-index;cli;search;mcp</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>andy-code-index</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Andy.CodeIndex.Shared\Andy.CodeIndex.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

</Project>
