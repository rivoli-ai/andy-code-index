{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AndyAuth": {
    "Provider": "AndyAuth",
    "Authority": "",
    "Audience": "urn:andy-code-index-api",
    "RequireHttpsMetadata": false
  },
  "Rbac": {
    "ApiBaseUrl": "",
    "ApplicationCode": "code-index"
  },
  "Indexing": {
    "FileFilters": {
      "SkipExtensions": [
        ".exe", ".dll", ".so", ".dylib", ".bin",
        ".zip", ".tar", ".gz", ".jar",
        ".png", ".jpg", ".jpeg", ".gif", ".ico", ".bmp", ".tiff",
        ".mp3", ".mp4", ".wav",
        ".woff", ".woff2", ".ttf", ".eot",
        ".pyc", ".class", ".o", ".obj", ".pdb"
      ],
      "SkipPatterns": [
        "node_modules/**",
        ".git/**",
        "vendor/**",
        "bin/**",
        "obj/**",
        "dist/**",
        "build/**",
        "*.min.js",
        "*.min.css",
        "package-lock.json",
        "yarn.lock"
      ],
      "MaxFileSizeBytes": 1048576
    }
  },
  "Embedding": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "text-embedding-3-small",
    "Dimensions": 1536,
    "ApiKey": "",
    "MaxBatchSize": 20,
    "MaxBatchChars": 16000,
    "TimeoutSeconds": 60,
    "MaxRetries": 5,
    "Parallelism": 1
  },
  "Enrichment": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "ApiKey": "",
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  }
}
